{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GR5526 CI Pipeline Test Result",
  "description": "Standardized test result format for consumption by n8n, Dashboard, or AI systems.",
  "type": "object",
  "required": [
    "job",
    "build_number",
    "git_commit",
    "chip",
    "hardware_agent",
    "flash",
    "boot_test",
    "app_test",
    "rtt"
  ],
  "properties": {
    "job": {
      "type": "string",
      "description": "Jenkins job name"
    },
    "build_number": {
      "type": "integer",
      "description": "Jenkins build number"
    },
    "git_commit": {
      "type": "string",
      "description": "Git commit SHA (full)"
    },
    "git_branch": {
      "type": "string",
      "description": "Git branch name"
    },
    "chip": {
      "type": "string",
      "description": "Target chip name (e.g. GR5526)"
    },
    "hardware_agent": {
      "type": "string",
      "description": "Jenkins agent label that ran the build (e.g. gr5526-hw)"
    },
    "build_type": {
      "type": "string",
      "description": "Build type: normal, dry-run, prebuilt-firmware, layout-fallback",
      "enum": ["normal", "dry-run", "prebuilt-firmware", "layout-fallback"]
    },
    "flash": {
      "type": "object",
      "description": "Flash stage results",
      "required": ["erase", "app_program", "boot_program", "verify"],
      "properties": {
        "erase": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIPPED", "DRY_RUN"],
          "description": "Erase region result"
        },
        "app_program": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIPPED", "DRY_RUN"],
          "description": "App programming result (MANDATORY)"
        },
        "boot_program": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIPPED", "DRY_RUN"],
          "description": "Bootloader programming result (MANDATORY)"
        },
        "verify": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIPPED", "DRY_RUN"],
          "description": "Flash verification result (MANDATORY GATE)"
        }
      }
    },
    "boot_test": {
      "type": "string",
      "enum": ["PASS", "FAIL", "SKIPPED", "DRY_RUN", "WARNING"],
      "description": "Bootloader boot test result (MANDATORY)"
    },
    "app_test": {
      "type": "string",
      "enum": ["PASS", "FAIL", "SKIPPED", "DRY_RUN", "WARNING"],
      "description": "App functional test result (MANDATORY)"
    },
    "rtt": {
      "type": "object",
      "description": "RTT diagnostic results (OPTIONAL / UNSTABLE - does not fail build)",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIPPED", "DRY_RUN", "WARNING", "UNSTABLE"],
          "description": "RTT diagnostic status"
        },
        "bl_rtt_addr": {
          "type": "string",
          "description": "Bootloader RTT control block address"
        },
        "app_rtt_addr": {
          "type": "string",
          "description": "App RTT control block address"
        },
        "notes": {
          "type": "string",
          "description": "Additional diagnostic notes"
        }
      }
    },
    "warnings": {
      "type": "array",
      "description": "Non-fatal warnings collected during pipeline execution",
      "items": {
        "type": "string"
      }
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of result generation"
    }
  }
}
