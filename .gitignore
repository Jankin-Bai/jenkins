# Python virtual environment
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Build artifacts (generated by pipeline, never commit)
artifacts/
*.bin
*.elf
*.map
*.o
*.obj
*.lst
obj_list.txt
bl_fw.bin
app_fw.bin
verify_*.bin
rtt_result.json
sca_boot_info.bin

# Jenkins workspace temp
@tmp/
@script/
workspace/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log
logs/
